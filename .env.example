# Copy the keys you need into a local .env file (never commit it).
# Server-side only — values here are never sent to the browser.

# Exa threat-intel search: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Gmail SMTP (password-reset emails).
# Create a Google Account "App Password" at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
